# =============================================================================
# lead-normalize-migration — configuración
# Copiar a .env y completar. NO commitear .env.
# =============================================================================

# Destino: BD normalizada — schema MySQL `TNFG_INTAKE`
MIG_TARGET_HOST=127.0.0.1
MIG_TARGET_PORT=3306
MIG_TARGET_USER=
MIG_TARGET_PASSWORD=
MIG_TARGET_DATABASE=TNFG_INTAKE

# Origen (opcional): BD donde está tblLeads + catálogos de producción
# Si se omite, se asume que tblLeads ya está en MIG_TARGET_DATABASE (modo staging).
MIG_SOURCE_HOST=
MIG_SOURCE_PORT=3306
MIG_SOURCE_USER=
MIG_SOURCE_PASSWORD=
MIG_SOURCE_DATABASE=

# Tamaño de lote para migrate (default 200)
MIG_BATCH_SIZE=200

# Muestra: migrar solo N leads (0 = todos). Ej: 500 para prueba
MIG_LIMIT=500

# Staging local de tblLeads en destino (no pisa vista tblLeads)
MIG_SOURCE_LEADS_TABLE=tblLeads_src
MIG_SOURCE_LEADS_ON_TARGET=1

# Cron (expression en dbProduction.tblCron / tblCronConfig — no en .env)
PROCESS_NAME_INTAKE_SYNC=TNFG_INTAKE_SYNC
CRON_WATCH_INTERVAL_MS=30000
